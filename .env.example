# 1. Paste your MongoDB connection link here
MONGODB_URI=
MONGODB_DB=lapinoz_inventory

# 2. Father's login (sees everything, gets low-stock alerts)
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=

# 3. Employee login
EMPLOYEE_NAME=
EMPLOYEE_EMAIL=
EMPLOYEE_PASSWORD=

# Keeps logins secure. Already generated, do not share it.
AUTH_SECRET=

# 4. Optional: fill these so low-stock alerts also reach father's email.
# For Gmail use smtp.gmail.com, port 465 and a Google "App Password".
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
